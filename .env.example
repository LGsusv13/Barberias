PORT=3000

# Notificacion al barbero por Telegram (gratis, no necesita dominio)
# Ver instrucciones en el README para crear el bot y obtener estos valores
TELEGRAM_BOT_TOKEN=tu_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id

# Correo transaccional con Resend (opcional, funciona en Render; Gmail por SMTP no funciona ahi)
# Crea una cuenta gratis en https://resend.com y copia tu API key aqui:
RESEND_API_KEY=re_tu_api_key_aqui

# Direccion remitente. Mientras no verifiques tu propio dominio en Resend,
# deja "onboarding@resend.dev". Si verificas tu dominio, usa algo como
# "citas@tudominio.com"
FROM_EMAIL=onboarding@resend.dev

# Correo del barbero/dueño que recibe copia de cada cita
BARBER_EMAIL=tu_correo@gmail.com

# Google Calendar
CALENDAR_ID=tu_correo@gmail.com
TIMEZONE=America/Guayaquil

# Credenciales de la cuenta de servicio de Google Calendar.
# En LOCAL: deja esto vacío y coloca el archivo credentials.json en la raíz del proyecto.
# En RENDER: pega aquí el contenido COMPLETO del archivo credentials.json como una sola línea.
GOOGLE_CREDENTIALS_JSON=

# Credenciales para proteger el panel /dashboard (obligatorio en producción)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave
